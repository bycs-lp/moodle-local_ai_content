{{!
    @template local_ai_content/source_selector

    Renders the unified source-selector React component for a given Moodle context.

    The component renders the launch button, preloads and manages selected source IDs,
    and shows the modal with source-selection UI.

    Context variables required for this template:
    * contextid (int) - The Moodle context ID for which source selection is managed.

    Example context (json):
    {
        "contextid": 42
    }
}}
{{#react}}
{
    "component": "@moodle/lms/local_ai_content/source_selector",
    "props": {
        "contextId": {{contextid}}
    },
    "class": "source-selector-launcher-wrapper"
}
{{> core/loading }}
{{/react}}





